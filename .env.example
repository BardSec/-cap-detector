# ── Required ──────────────────────────────────────────────────────────────────

# Random secret used to sign JWT tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-long-random-string

# ── OAuth providers (configure at least one) ──────────────────────────────────

# Microsoft 365 / Azure AD
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
# Redirect URI to register: https://<your-domain>/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Google Workspace
# Register an app at https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI to register: https://<your-domain>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Deployment ────────────────────────────────────────────────────────────────

# Public URL of this deployment — used to build OAuth callback redirect URIs.
# Must exactly match the redirect URI registered in your OAuth app.
FRONTEND_URL=https://pcap.bardsec.com

# Restrict logins to specific email domains (comma-separated). Leave empty to allow any.
# Example: ALLOWED_DOMAINS=school.edu,district.org
ALLOWED_DOMAINS=

# ── Database & queue (defaults work for docker compose) ──────────────────────

POSTGRES_USER=pcapbloodhound
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=pcapbloodhound

# These are constructed automatically from the above in docker-compose.yml:
# DATABASE_URL=postgresql://pcapbloodhound:...@postgres:5432/pcapbloodhound
# REDIS_URL=redis://redis:6379/0

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
