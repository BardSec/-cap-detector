# ─────────────────────────────────────────────────────────
#  PCAP Bloodhound  —  Environment Configuration
# ─────────────────────────────────────────────────────────
#  Copy this file to .env and fill in real values.
#  Generate SECRET_KEY with:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────

# App secret (REQUIRED – change before deploying)
SECRET_KEY=generate-a-real-64-char-hex-secret-here

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=pcapbloodhound
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pcapbloodhound

# ── Microsoft 365 / Azure AD OAuth ───────────────────────
# Register at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Redirect URI to add: http://<YOUR_DOMAIN>/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "common" to allow any tenant, or your specific tenant ID
MICROSOFT_TENANT_ID=common

# ── Google Workspace OAuth ────────────────────────────────
# Register at: https://console.cloud.google.com/apis/credentials
# Redirect URI to add: http://<YOUR_DOMAIN>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Access Control ────────────────────────────────────────
# Restrict login to specific email domains (comma-separated).
# Leave empty to allow any authenticated user.
# Example: ALLOWED_DOMAINS=myschool.edu,district.k12.us
ALLOWED_DOMAINS=

# ── App URL (used for OAuth redirect URIs) ────────────────
FRONTEND_URL=http://localhost

# ── Limits ───────────────────────────────────────────────
# Max PCAP upload size in megabytes
MAX_UPLOAD_MB=200

# Port to expose on the host
HTTP_PORT=80
